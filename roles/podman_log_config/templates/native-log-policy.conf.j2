# Native component log policy; identical for components sharing one source.
# Wrapper revision: {{ lookup('ansible.builtin.template', role_path ~ '/templates/conmon-wrapper.sh.j2') | hash('sha256') }}
{% if podman_log_config_quadlet_path.endswith('.kube') %}
[Kube]
GlobalArgs=--conmon={{ podman_log_config_conmon_wrapper }}
LogDriver=k8s-file
PodmanArgs=--log-opt=max-size=104857600
{% else %}
[Container]
GlobalArgs=--conmon={{ podman_log_config_conmon_wrapper }}
LogDriver=k8s-file
LogOpt=max-size=104857600
{% endif %}

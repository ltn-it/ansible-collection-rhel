[Unit]
Description=Bounded component archive inode metadata check
StartLimitIntervalSec=30
StartLimitBurst=120

[Service]
Type=oneshot
User=root
Group=root
ExecStart={{ podman_log_config_python }} -I -B {{ podman_log_config_helper_directory }}/inode_guard.py --config {{ podman_log_config_config_directory }}/{{ podman_log_config_component }}.inode-guard.json
WorkingDirectory=/
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=~ptrace process_vm_readv process_vm_writev kcmp
TimeoutStartSec=20
TasksMax=1
MemoryMax=64M
StandardOutput=null
StandardError=journal
